# Local .terraform directories containing downloaded provider plugins
**/.terraform/*

# .tfstate files contain sensitive resource IDs and configurations
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan files
*.tfplan
